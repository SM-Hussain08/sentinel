# =========================================================
# SENTINEL
# Example environment configuration
# =========================================================
#
# Copy this file to:
#
#   .env
#
# before running the application locally with Docker Compose.
#
# Core SENTINEL works without Ollama.
# Local AI is optional and disabled by default.
# =========================================================


# ---------------------------------------------------------
# Application
# ---------------------------------------------------------

APP_NAME=SENTINEL
APP_ENV=production
DEBUG=false


# ---------------------------------------------------------
# Backend
# ---------------------------------------------------------

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000


# Nginx frontend / application gateway
FRONTEND_PORT=8080


# ---------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=sentinel
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


# Used only with docker-compose.dev.yml when direct host
# access to the isolated benchmark database is required.
BENCHMARK_POSTGRES_PORT=5433


# ---------------------------------------------------------
# Database connection
# ---------------------------------------------------------
#
# Docker Compose services communicate with PostgreSQL using
# the internal service hostname "postgres".
#
# This value is mainly useful for local tooling outside
# Compose. Docker Compose provides its own DATABASE_URL to
# backend/runtime containers.
# ---------------------------------------------------------

DATABASE_URL=postgresql+psycopg://sentinel:CHANGE_ME_TO_A_STRONG_PASSWORD@localhost:5432/sentinel


# ---------------------------------------------------------
# SENTINEL Event Processor
# ---------------------------------------------------------

SENTINEL_PROCESSOR_POLL_SECONDS=1
SENTINEL_PROCESSOR_BATCH_SIZE=100
SENTINEL_PROCESSOR_WORKER_ID=processor-docker


# ---------------------------------------------------------
# Optional Live Simulation
# ---------------------------------------------------------

SENTINEL_SIM_PRESET=normal
SENTINEL_SIM_ATTACK_RATE=0
SENTINEL_SIM_SEED=9300

SENTINEL_SIM_TICK_SECONDS=1
SENTINEL_SIM_SPEED=1

SENTINEL_SIM_HEARTBEAT_SECONDS=5
SENTINEL_SIM_EMPLOYEE_REFRESH_SECONDS=30

SENTINEL_SIM_MAX_EVENTS_PER_TICK=100
SENTINEL_SIM_MAX_EVENTS_PER_EMPLOYEE_PER_TICK=3

SENTINEL_SIM_SCENARIO_COOLDOWN_MINUTES=360
SENTINEL_SIM_MAX_CONCURRENT_ATTACKS=1

SENTINEL_SIM_WORKER_ID=simulator-docker


# ---------------------------------------------------------
# Optional Local AI / Ollama
# ---------------------------------------------------------
#
# SENTINEL's core security pipeline does not depend on
# Ollama.
#
# When disabled, the following remain fully operational:
#
# - anomaly detection
# - incident correlation
# - deterministic investigation
# - employee intelligence
# - simulation
# - benchmark workflows
#
# To enable the optional local AI layer later:
#
#   OLLAMA_ENABLED=true
#
# and run Ollama independently on the host.
# ---------------------------------------------------------

OLLAMA_ENABLED=false

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_PREDICT=280
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_KEEP_ALIVE=10m
