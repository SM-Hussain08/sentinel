# =========================================================
# SENTINEL
# Example environment configuration
# =========================================================

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------

APP_NAME=SENTINEL
APP_ENV=development
DEBUG=true


# ---------------------------------------------------------
# Backend
# ---------------------------------------------------------

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000


# ---------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_password
POSTGRES_DB=sentinel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432


# ---------------------------------------------------------
# Database connection
# ---------------------------------------------------------

DATABASE_URL=postgresql+psycopg://sentinel:sentinel_dev_password@localhost:5432/sentinel


# ---------------------------------------------------------
# Local AI / Ollama
# ---------------------------------------------------------

# Enable or disable SENTINEL's optional local AI investigation layer.
#
# When disabled, ML detection, incident correlation, timelines,
# and deterministic investigation remain fully operational.
OLLAMA_ENABLED=true

# Ollama's local HTTP API.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Selected local model.
OLLAMA_MODEL=llama3.2:3b

# Maximum amount of time SENTINEL will wait for one generation.
OLLAMA_TIMEOUT_SECONDS=90

# Low temperature improves consistency and evidence grounding.
OLLAMA_TEMPERATURE=0

# Maximum number of tokens generated for one analyst brief.
OLLAMA_NUM_PREDICT=280

# Practical context window used by SENTINEL.
OLLAMA_CONTEXT_WINDOW=4096

# Keep the model loaded between nearby requests to reduce
# repeated cold-start latency during demonstrations.
OLLAMA_KEEP_ALIVE=10m