# =========================================================
# SENTINEL
# Example environment configuration
# =========================================================

# Application
APP_NAME=SENTINEL
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_password
POSTGRES_DB=sentinel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database connection
DATABASE_URL=postgresql+psycopg://sentinel:sentinel_dev_password@localhost:5432/sentinel