# =========================================================
# SENTINEL
# Git ignore rules
# =========================================================

# -------------------------
# Environment variables
# -------------------------
.env
.env.local
.env.*.local

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/

coverage.xml
.coverage
htmlcov/

# Python package/build files
build/
dist/
*.egg-info/

# -------------------------
# Machine Learning
# -------------------------
*.pkl
*.joblib

# Generated datasets
ml_engine/data/generated/
ml_engine/data/processed/
ml_engine/models/artifacts/

# -------------------------
# Node / React
# -------------------------
node_modules/
frontend/node_modules/

frontend/dist/
frontend/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# IDE / Editor
# -------------------------
.vscode/
.idea/

# -------------------------
# Operating system
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
# Logs
# -------------------------
*.log
logs/

# -------------------------
# Docker / local runtime
# -------------------------
postgres_data/

# -------------------------
# Temporary files
# -------------------------
tmp/
temp/
*.tmp