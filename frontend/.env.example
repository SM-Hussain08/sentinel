# =========================================================
# SENTINEL Frontend
# =========================================================
#
# Production Docker builds use the same-origin path:
#
#   /api/v1
#
# Nginx proxies this internally to the FastAPI backend.
#
# For standalone Vite development outside Docker, you may
# instead use:
#
#   http://127.0.0.1:8000/api/v1
# =========================================================

VITE_API_BASE_URL=/api/v1
